diff --git a/spdm_emu/spdm_emu_common/spdm_emu.h b/spdm_emu/spdm_emu_common/spdm_emu.h
index 85d1c64..f81677c 100644
--- a/spdm_emu/spdm_emu_common/spdm_emu.h
+++ b/spdm_emu/spdm_emu_common/spdm_emu.h
@@ -228,6 +228,33 @@ bool write_bytes(const SOCKET socket, const uint8_t *buffer,
                                              LIBSPDM_TRANSPORT_ADDITIONAL_SIZE)
 #define LIBSPDM_DATA_TRANSFER_SIZE LIBSPDM_RECEIVER_DATA_TRANSFER_SIZE
 
+/* Overrides the DataTransferSize this endpoint ADVERTISES. Zero means "use
+ * LIBSPDM_DATA_TRANSFER_SIZE", which is the unpatched behaviour. Set by
+ * --data_transfer_size.
+ *
+ * It can only be lowered, never raised: DataTransferSize is what an endpoint
+ * tells its peer it can receive in one message, and advertising more than the
+ * buffer can hold is a lie the peer acts on. */
+extern uint32_t m_use_data_transfer_size;
+
+/* The receiver buffer size to register with libspdm, which is where
+ * DataTransferSize comes from: libspdm_register_device_buffer_func subtracts
+ * the transport header and tail and keeps the remainder as the advertised
+ * value. So the way to advertise less is to register less.
+ *
+ * The overhead term is written as the difference between the two macros above
+ * rather than as LIBSPDM_TRANSPORT_ADDITIONAL_SIZE, so that it stays equal to
+ * whatever the default path subtracts even if those definitions move. It is
+ * exact for the transports that register that same overhead — MCTP and
+ * PCI_DOE. For SOCKET_TRANSPORT_TYPE_NONE, which registers zero header and
+ * tail, the advertised value comes out one overhead high; the harness reads
+ * DataTransferSize back out of the CAPABILITIES messages and fails the run on
+ * any mismatch, so this cannot pass unnoticed. */
+#define LIBSPDM_EFFECTIVE_RECEIVER_BUFFER_SIZE                       \
+    ((m_use_data_transfer_size == 0) ? LIBSPDM_RECEIVER_BUFFER_SIZE  \
+     : (m_use_data_transfer_size +                                   \
+        (LIBSPDM_RECEIVER_BUFFER_SIZE - LIBSPDM_DATA_TRANSFER_SIZE)))
+
 #if (LIBSPDM_SENDER_BUFFER_SIZE > LIBSPDM_RECEIVER_BUFFER_SIZE)
 #define LIBSPDM_MAX_SENDER_RECEIVER_BUFFER_SIZE LIBSPDM_SENDER_BUFFER_SIZE
 #else
